---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Checkout | Serum 72" description="Complete your Native Ceuticals order securely with Stripe.">
  <header class="page-hero"><h1>Checkout</h1></header>
  <main class="checkout-shell"><section class="checkout-card">
    <p class="checkout-notice" data-cancelled hidden>Payment was cancelled. Your cart is still saved.</p>
    <div data-checkout-empty hidden><h2>Your cart is empty</h2><a class="btn" href="/shop/">CONTINUE SHOPPING</a></div>
    <div data-checkout-ready hidden><h2>Review your order</h2><div class="checkout-lines" data-checkout-lines></div><div class="checkout-total"><span>Subtotal</span><strong data-checkout-total>$0.00</strong></div><p class="checkout-secure">You’ll continue to Stripe’s secure checkout to enter contact, shipping, and payment details. Serum 72 never receives or stores your full card number.</p><label class="checkout-terms"><input type="checkbox" data-terms /> <span>I agree to the <a href="/terms/">Terms</a>, <a href="/shipping/">Shipping &amp; Returns Policy</a>, and <a href="/privacy/">Privacy Policy</a>.</span></label><p class="checkout-error" data-checkout-error hidden></p><button class="btn checkout-submit" type="button" data-checkout-submit>CONTINUE TO SECURE PAYMENT</button></div>
  </section></main>
</BaseLayout>
<script>
  type CartItem={slug:string;name:string;price:number;image:string;quantity:number;purchaseType?:'once'|'subscribe'};
  const read=():CartItem[]=>{try{const value=JSON.parse(localStorage.getItem('serum72_cart')||'[]');return Array.isArray(value)?value:[];}catch{return[];}};
  const items=read(),empty=document.querySelector<HTMLElement>('[data-checkout-empty]'),ready=document.querySelector<HTMLElement>('[data-checkout-ready]');
  if(!items.length){if(empty)empty.hidden=false;}else{if(ready)ready.hidden=false;const lines=document.querySelector<HTMLElement>('[data-checkout-lines]');items.forEach(item=>{const row=document.createElement('article');row.innerHTML=`<img src="${item.image}" alt=""><div><strong>${item.name}</strong><span>${item.purchaseType==='subscribe'?'Monthly subscription':'One-time purchase'} · Qty ${item.quantity}</span></div><b>$${(item.price*item.quantity).toFixed(2)}</b>`;lines?.append(row);});const total=items.reduce((sum,item)=>sum+item.price*item.quantity,0),output=document.querySelector('[data-checkout-total]');if(output)output.textContent=`$${total.toFixed(2)}`;}
  if(new URLSearchParams(location.search).get('payment')==='cancelled'){const notice=document.querySelector<HTMLElement>('[data-cancelled]');if(notice)notice.hidden=false;}
  document.querySelector('[data-checkout-submit]')?.addEventListener('click',async()=>{const terms=document.querySelector<HTMLInputElement>('[data-terms]'),error=document.querySelector<HTMLElement>('[data-checkout-error]'),button=document.querySelector<HTMLButtonElement>('[data-checkout-submit]');if(!terms?.checked){if(error){error.textContent='Please accept the policies to continue.';error.hidden=false;}return;}if(button){button.disabled=true;button.textContent='CONNECTING TO STRIPE…';}try{const response=await fetch('/api/checkout-session.php',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:read().map(({slug,quantity,purchaseType})=>({slug,quantity,purchaseType:purchaseType||'once'}))})}),data=await response.json();if(!response.ok)throw new Error(data.error||'Unable to start checkout.');location.href=data.url;}catch(reason){if(error){error.textContent=reason instanceof Error?reason.message:'Unable to start checkout.';error.hidden=false;}if(button){button.disabled=false;button.textContent='CONTINUE TO SECURE PAYMENT';}}});
</script>
<style>
  .checkout-shell{min-height:55vh;padding:64px 5vw 96px;background:#f5f5f3}.checkout-card{max-width:820px;margin:auto;padding:40px;background:#fff}.checkout-card h2{margin-top:0}.checkout-lines{display:grid;gap:14px;margin:28px 0}.checkout-lines article{display:grid;grid-template-columns:72px 1fr auto;align-items:center;gap:18px;padding-bottom:14px;border-bottom:1px solid #ddd}.checkout-lines img{width:72px;height:72px;object-fit:contain;background:#f4f4f4}.checkout-lines span{display:block;margin-top:5px;color:#666}.checkout-total{display:flex;justify-content:space-between;font-size:1.15rem}.checkout-secure{margin:30px 0 20px;color:#555}.checkout-terms{display:flex;gap:10px;align-items:flex-start}.checkout-error,.checkout-notice{padding:12px;background:#fbe9e7;color:#8a2117}.checkout-submit{width:100%;margin-top:24px}.checkout-submit:disabled{opacity:.6}@media(max-width:600px){.checkout-card{padding:24px 18px}.checkout-lines article{grid-template-columns:56px 1fr}.checkout-lines article>b{grid-column:2}.checkout-lines img{width:56px;height:56px}}
</style>
