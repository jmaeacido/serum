---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Serum 72 | Admin Dashboard">
<div class="admin-app"><aside class="admin-sidebar"><a class="admin-brand" href="/"><img src="/assets/site/logo-white.png" alt="Native Ceuticals" /></a><nav class="side-nav"><button class="side-link active" data-view="overview">⌂ <span>Overview</span></button><button class="side-link" data-view="orders">□ <span>Orders</span><b data-order-badge>0</b></button><button class="side-link" data-view="products">◇ <span>Products</span></button><button class="side-link" data-view="customers">○ <span>Customers</span></button><a class="side-link" href="/admin/emails/">✉ <span>Messages</span></a></nav><div class="sidebar-foot"><a href="/" target="_blank">View storefront ↗</a><button data-logout>Log out</button></div></aside>
<main class="dashboard-main"><header class="dashboard-top"><button class="menu-button" data-menu>☰</button><div><p class="eyebrow">SERUM 72 ADMIN</p><h1 data-title>Good evening.</h1></div><div class="admin-profile"><span>S72</span><div><strong>Store admin</strong><small>Operations</small></div></div></header><div class="notice" data-notice hidden></div>
<section class="view active" data-section="overview"><div class="section-heading"><div><h2>Store overview</h2><p>A live snapshot of your storefront performance.</p></div><p data-updated>Loading store data…</p></div><div class="metric-grid"><article class="metric-card"><span>NET REVENUE</span><strong data-metric="revenue">—</strong><small>Completed sales</small></article><article class="metric-card"><span>TOTAL ORDERS</span><strong data-metric="orders">—</strong><small>All-time orders</small></article><article class="metric-card"><span>CUSTOMERS</span><strong data-metric="customers">—</strong><small>Unique shoppers</small></article><article class="metric-card accent"><span>SUBSCRIPTIONS</span><strong data-metric="subscribers">—</strong><small>Recurring customers</small></article></div><div class="dashboard-grid"><section class="dash-card span-two"><div class="card-heading"><div><h3>Recent orders</h3><p>Your latest customer purchases.</p></div><button class="text-button" data-go="orders">View all</button></div><div class="responsive-table"><table><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Total</th><th>Status</th></tr></thead><tbody data-recent-orders></tbody></table></div></section><section class="dash-card"><div class="card-heading"><div><h3>Store pulse</h3><p>Operational totals.</p></div></div><div class="pulse-list"><div><span>Products sold</span><strong data-metric="units">—</strong></div><div><span>Messages logged</span><strong data-metric="messages">—</strong></div><div><span>Catalog products</span><strong>5</strong></div></div></section></div></section>
<section class="view" data-section="orders"><div class="section-heading"><div><h2>Orders</h2><p>Review, search, and update fulfillment status.</p></div></div><section class="dash-card"><div class="filter-bar"><input type="search" data-order-search placeholder="Search order, customer, or email"><select data-order-filter><option value="">All statuses</option><option>paid</option><option>processing</option><option>fulfilled</option><option>cancelled</option><option>refunded</option></select><span data-order-count></span></div><div class="responsive-table"><table><thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Date</th><th>Total</th><th>Status</th></tr></thead><tbody data-all-orders></tbody></table></div></section></section>
<section class="view" data-section="products"><div class="section-heading"><div><h2>Products</h2><p>Your active Serum 72 catalog and inventory.</p></div></div><div class="product-grid" data-products></div></section>
<section class="view" data-section="customers"><div class="section-heading"><div><h2>Customers</h2><p>Customer history derived from completed orders.</p></div></div><section class="dash-card"><div class="responsive-table"><table><thead><tr><th>Customer</th><th>Contact</th><th>Orders</th><th>Total spent</th><th>Last order</th></tr></thead><tbody data-customers></tbody></table></div></section></section></main></div>
</AdminLayout>
<script>
type StoreData={metrics:Record<string,number>,orders:any[],products:any[]};const API=location.port==='4321'?'http://localhost/serum72/api':`${location.pathname.split('/admin/')[0]}/api`;let store:StoreData={metrics:{},orders:[],products:[]};const one=(s:string)=>document.querySelector(s) as HTMLElement;const all=(s:string)=>[...document.querySelectorAll(s)] as HTMLElement[];const esc=(v:any)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'} as any)[c]);const money=(v:any,c='USD')=>new Intl.NumberFormat('en-US',{style:'currency',currency:c||'USD'}).format(Number(v)||0);const date=(v:any)=>v?new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',year:'numeric'}).format(new Date(v)):'—';const badge=(v:string)=>`<span class="status status--${esc(v)}">${esc(v||'paid')}</span>`;
const orderRow=(o:any,edit=false)=>`<tr><td><a class="record-link" href="${location.pathname.split('/admin/')[0]}/admin/order/?id=${encodeURIComponent(o.id)}">${esc(o.id)}</a></td><td><strong>${esc(o.customer?.name||'Guest')}</strong><small>${esc(o.customer?.email||'')}</small></td>${edit?`<td>${esc((o.items||[]).map((i:any)=>`${i.quantity}× ${i.name}`).join(', '))}</td>`:''}<td>${date(o.createdAt)}</td><td><strong>${money(o.total,o.currency)}</strong></td><td>${edit?`<select class="status-select" data-status-id="${esc(o.id)}">${['paid','processing','fulfilled','cancelled','refunded'].map(s=>`<option ${o.status===s?'selected':''}>${s}</option>`).join('')}</select>`:badge(o.status)}</td></tr>`;
function showView(name:string){all('[data-section]').forEach(v=>v.classList.toggle('active',v.dataset.section===name));all('[data-view]').forEach(v=>v.classList.toggle('active',v.dataset.view===name));one('[data-title]').textContent=name==='overview'?'Good evening.':name[0].toUpperCase()+name.slice(1);document.body.classList.remove('menu-open');history.replaceState(null,'',name==='overview'?'#':`#${name}`)}
function renderOrders(){const q=(one('[data-order-search]') as HTMLInputElement).value.toLowerCase(),f=(one('[data-order-filter]') as HTMLSelectElement).value,orders=store.orders.filter(o=>(!f||o.status===f)&&(!q||JSON.stringify([o.id,o.customer,o.items]).toLowerCase().includes(q)));one('[data-order-count]').textContent=`${orders.length} order${orders.length===1?'':'s'}`;one('[data-all-orders]').innerHTML=orders.length?orders.map(o=>orderRow(o,true)).join(''):'<tr><td colspan="6" class="empty">No matching orders.</td></tr>';all('[data-status-id]').forEach(el=>el.addEventListener('change',updateStatus))}
function render(){Object.entries(store.metrics).forEach(([k,v])=>all(`[data-metric="${k}"]`).forEach(el=>el.textContent=k==='revenue'?money(v):String(v)));one('[data-order-badge]').textContent=String(store.orders.filter(o=>!['fulfilled','cancelled','refunded'].includes(o.status)).length);one('[data-recent-orders]').innerHTML=store.orders.slice(0,5).map(o=>orderRow(o)).join('')||'<tr><td colspan="5" class="empty">No orders yet.</td></tr>';renderOrders();one('[data-products]').innerHTML=store.products.map(p=>`<article class="product-card"><div class="product-image"><img src="${esc(p.image)}" alt=""></div><div><span class="availability">ACTIVE</span><h3>${esc(p.name)}</h3><p>${money(p.price)} <span>· Subscribe ${money(p.subscriptionPrice)}</span></p><div class="stock"><i style="width:${Math.min(p.stock,100)}%"></i></div><small>${p.stock} units in stock</small></div></article>`).join('');const cs=new Map();store.orders.forEach(o=>{let e=o.customer?.email||'Guest',c=cs.get(e)||{name:o.customer?.name||'Guest',email:e,phone:o.customer?.phone||'',count:0,total:0,last:o.createdAt};c.count++;c.total+=Number(o.total)||0;if(o.createdAt>c.last)c.last=o.createdAt;cs.set(e,c)});one('[data-customers]').innerHTML=[...cs.values()].map(c=>`<tr><td><strong>${esc(c.name)}</strong></td><td>${esc(c.email)}<small>${esc(c.phone)}</small></td><td>${c.count}</td><td><strong>${money(c.total)}</strong></td><td>${date(c.last)}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">No customers yet.</td></tr>';one('[data-updated]').textContent=`Updated ${new Date().toLocaleTimeString([],{hour:'numeric',minute:'2-digit'})}`}
async function updateStatus(e:Event){const s=e.currentTarget as HTMLSelectElement;s.disabled=true;try{const r=await fetch(`${API}/admin-dashboard.php`,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:s.dataset.statusId,status:s.value})}),d=await r.json();if(!r.ok)throw new Error(d.error);store.orders[store.orders.findIndex(o=>o.id===d.order.id)]=d.order;render();flash(`Order ${d.order.id} updated.`)}catch(x){flash(x instanceof Error?x.message:'Update failed.',true);s.disabled=false}}
function flash(m:string,error=false){const n=one('[data-notice]');n.textContent=m;n.classList.toggle('error-notice',error);n.hidden=false;setTimeout(()=>n.hidden=true,3500)}async function load(){try{const r=await fetch(`${API}/admin-dashboard.php`,{credentials:'include'}),d=await r.json();if(r.status===401){location.replace('/admin/login/');return}if(!r.ok)throw new Error(d.error);store=d;render()}catch(e){flash(e instanceof Error?e.message:'Dashboard could not be loaded.',true)}}
all('[data-view]').forEach(e=>e.addEventListener('click',()=>showView(e.dataset.view!)));all('[data-go]').forEach(e=>e.addEventListener('click',()=>showView(e.dataset.go!)));one('[data-order-search]').addEventListener('input',renderOrders);one('[data-order-filter]').addEventListener('change',renderOrders);one('[data-menu]').addEventListener('click',()=>document.body.classList.toggle('menu-open'));one('[data-logout]').addEventListener('click',async()=>{try{await fetch(`${API}/admin-logout.php`,{method:'POST',credentials:'include'})}finally{location.href='/admin/login/'}});const initial=location.hash.slice(1);if(['orders','products','customers'].includes(initial))showView(initial);load();
</script>
