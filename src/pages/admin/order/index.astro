---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Serum 72 | Order Details"><div class="admin-app"><aside class="admin-sidebar"><a class="admin-brand" href="/"><img src="/assets/site/logo-white.png" alt="Native Ceuticals" /></a><nav class="side-nav"><a class="side-link" href="/admin/">⌂ <span>Overview</span></a><a class="side-link active" href="/admin/#orders">□ <span>Orders</span></a><a class="side-link" href="/admin/#products">◇ <span>Products</span></a><a class="side-link" href="/admin/#customers">○ <span>Customers</span></a><a class="side-link" href="/admin/emails/">✉ <span>Messages</span></a></nav><div class="sidebar-foot"><a href="/" target="_blank">View storefront ↗</a><button data-logout>Log out</button></div></aside><main class="dashboard-main"><header class="dashboard-top"><button class="menu-button" data-menu>☰</button><div><p class="eyebrow">SERUM 72 ADMIN</p><h1>Order detail</h1></div><div class="admin-profile"><span>S72</span><div><strong>Store admin</strong><small>Operations</small></div></div></header><div class="notice" data-notice hidden></div><div class="dashboard-detail"><a class="detail-back" href="/admin/#orders">← Back to orders</a><div data-detail class="detail-loading dash-card">Loading order…</div></div></main></div></AdminLayout>
<script>
const API=location.port==='4321'?'http://localhost/serum72/api':`${location.pathname.split('/admin/')[0]}/api`,id=new URLSearchParams(location.search).get('id'),root=document.querySelector<HTMLElement>('[data-detail]')!;let order:any;const e=(v:any)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'} as any)[c]),money=(v:any,c='USD')=>new Intl.NumberFormat('en-US',{style:'currency',currency:c}).format(v||0),statuses=['paid','processing','fulfilled','cancelled','refunded'];
function render(){const o=order,address=o.shipping?[o.shipping.line1,o.shipping.line2,[o.shipping.city,o.shipping.state,o.shipping.postal_code].filter(Boolean).join(', '),o.shipping.country].filter(Boolean).join('<br>'):'Not provided',units=o.items.reduce((n:number,i:any)=>n+Number(i.quantity),0);root.className='';root.innerHTML=`<div class="order-hero"><div><p class="eyebrow">ORDER ${e(o.id)}</p><h1>${e(o.customer?.name||'Guest customer')}</h1><p>Placed ${new Date(o.createdAt).toLocaleString()}</p></div><div class="order-action"><label><span>FULFILLMENT STATUS</span><select data-detail-status>${statuses.map(s=>`<option ${o.status===s?'selected':''}>${s}</option>`).join('')}</select></label></div></div><div class="order-summary"><div><span>TOTAL</span><strong>${money(o.total,o.currency)}</strong></div><div><span>ITEMS</span><strong>${units}</strong></div><div><span>PAYMENT</span><strong>Paid</strong></div><div><span>ORDER TYPE</span><strong>${o.stripeSubscriptionId?'Subscription':'One-time'}</strong></div></div><div class="detail-grid order-detail-grid"><section class="detail-card"><div class="card-heading"><div><h2>Order items</h2><p>${units} item${units===1?'':'s'} in this order</p></div></div><div class="detail-items">${o.items.map((i:any)=>`<div class="detail-item"><img src="/assets/products/${e(i.slug)}.${i.slug==='dual-action-cleanser'?'webp':'png'}" alt=""><div><strong>${e(i.name)}</strong><p>${i.purchaseType==='subscribe'?'Monthly subscription':'One-time purchase'} · Qty ${i.quantity}</p><small>${money(i.unitAmount/100,o.currency)} each</small></div><strong>${money(i.unitAmount*i.quantity/100,o.currency)}</strong></div>`).join('')}</div><div class="order-total"><span>Total paid</span><strong>${money(o.total,o.currency)}</strong></div></section><aside><section class="detail-card compact-card"><h2>Customer</h2><p><strong>${e(o.customer?.name||'Guest')}</strong></p><a class="contact-line" href="mailto:${e(o.customer?.email)}">${e(o.customer?.email||'No email')}</a><a class="contact-line" href="tel:${e(o.customer?.phone)}">${e(o.customer?.phone||'No phone')}</a></section><section class="detail-card compact-card detail-spaced"><h2>Shipping address</h2><p class="address">${address}</p></section><section class="detail-card compact-card detail-spaced"><h2>Payment</h2><div class="detail-list"><div class="detail-row"><span>Currency</span><strong>${e(o.currency)}</strong></div><div class="detail-row"><span>Stripe session</span><button class="copy-button" data-copy="${e(o.stripeSessionId)}" title="Copy Stripe session">Copy ID</button></div><div class="detail-row"><span>Subscription</span><strong>${e(o.stripeSubscriptionId?'Active':'No')}</strong></div></div></section></aside></div>`;(root.querySelector('[data-detail-status]') as HTMLSelectElement).addEventListener('change',updateStatus);root.querySelector('[data-copy]')?.addEventListener('click',async event=>{await navigator.clipboard.writeText((event.currentTarget as HTMLElement).dataset.copy||'');flash('Stripe session ID copied.')})}
async function updateStatus(event:Event){const select=event.currentTarget as HTMLSelectElement,previous=order.status;select.disabled=true;try{const r=await fetch(`${API}/admin-dashboard.php`,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:order.id,status:select.value})}),d=await r.json();if(!r.ok)throw new Error(d.error);order=d.order;render();flash(`Order status updated to ${order.status}.`)}catch(x){order.status=previous;render();flash(x instanceof Error?x.message:'Unable to update order.',true)}}
function flash(message:string,error=false){const n=document.querySelector<HTMLElement>('[data-notice]')!;n.textContent=message;n.classList.toggle('error-notice',error);n.hidden=false;setTimeout(()=>n.hidden=true,3000)}
fetch(`${API}/admin-dashboard.php`,{credentials:'include'}).then(async r=>{const d=await r.json();if(r.status===401){location.href='../login/';return}if(!r.ok)throw new Error(d.error);order=d.orders.find((x:any)=>x.id===id);if(!order)throw new Error('Order not found.');render()}).catch(x=>{root.textContent=x.message||'Unable to load order.'});document.querySelector('[data-menu]')?.addEventListener('click',()=>document.body.classList.toggle('menu-open'));document.querySelector('[data-logout]')?.addEventListener('click',async()=>{await fetch(`${API}/admin-logout.php`,{method:'POST',credentials:'include'});location.href='../login/'});
</script>
