---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Serum 72 | Email Details"><div class="admin-app"><aside class="admin-sidebar"><a class="admin-brand" href="/"><img src="/assets/site/logo-white.png" alt="Native Ceuticals" /></a><nav class="side-nav"><a class="side-link" href="/admin/">⌂ <span>Overview</span></a><a class="side-link" href="/admin/#orders">□ <span>Orders</span></a><a class="side-link" href="/admin/#products">◇ <span>Products</span></a><a class="side-link" href="/admin/#customers">○ <span>Customers</span></a><a class="side-link active" href="/admin/emails/">✉ <span>Messages</span></a></nav><div class="sidebar-foot"><a href="/" target="_blank">View storefront ↗</a><button data-logout>Log out</button></div></aside><main class="dashboard-main"><header class="dashboard-top"><button class="menu-button" data-menu>☰</button><div><p class="eyebrow">SERUM 72 ADMIN</p><h1>Message detail</h1></div><div class="admin-profile"><span>S72</span><div><strong>Store admin</strong><small>Operations</small></div></div></header><div class="dashboard-detail"><a class="detail-back" href="/admin/emails/">← Back to messages</a><div data-detail class="detail-loading dash-card">Loading message…</div></div></main></div></AdminLayout>
<script>
const API=location.port==='4321'?'http://localhost/serum72/api':`${location.pathname.split('/admin/')[0]}/api`,id=new URLSearchParams(location.search).get('id'),root=document.querySelector<HTMLElement>('[data-detail]')!;const e=(v:any)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'} as any)[c]);fetch(`${API}/admin-emails.php`,{credentials:'include'}).then(async r=>{const d=await r.json();if(r.status===401){location.href='../login/';return}if(!r.ok)throw new Error(d.error);const m=d.messages.find((x:any)=>x.id===id);if(!m)throw new Error('Email record not found.');root.className='';root.innerHTML=`<div class="detail-head"><div><p class="eyebrow">${e(m.direction)} EMAIL</p><h1>${e(m.subject||'(No subject)')}</h1><p class="muted">${new Date(m.date).toLocaleString()}</p></div><span class="status">${e(m.status||'saved')}</span></div><div class="detail-grid"><section class="detail-card"><h2>Message</h2><div class="detail-body">${e(m.body||m.preview||'No message content stored.')}</div></section><aside><section class="detail-card"><h2>Delivery details</h2><div class="detail-list"><div class="detail-row"><span>From</span><strong>${e(m.from||'—')}</strong></div><div class="detail-row"><span>To</span><strong>${e(m.to||'—')}</strong></div><div class="detail-row"><span>Direction</span><strong>${e(m.direction)}</strong></div><div class="detail-row"><span>Source</span><strong>${e(m.source||'website')}</strong></div><div class="detail-row"><span>Record ID</span><strong>${e(m.id)}</strong></div></div></section></aside></div>`}).catch(x=>{root.textContent=x.message||'Unable to load email.'});document.querySelector('[data-menu]')?.addEventListener('click',()=>document.body.classList.toggle('menu-open'));document.querySelector('[data-logout]')?.addEventListener('click',async()=>{await fetch(`${API}/admin-logout.php`,{method:'POST',credentials:'include'});location.href='../login/'});
</script>
