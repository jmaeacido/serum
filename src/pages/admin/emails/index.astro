---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Serum 72 | Admin Emails"><div class="admin-app"><aside class="admin-sidebar"><a class="admin-brand" href="/"><img src="/assets/site/logo-white.png" alt="Native Ceuticals" /></a><nav class="side-nav"><a class="side-link" href="/admin/">⌂ <span>Overview</span></a><a class="side-link" href="/admin/#orders">□ <span>Orders</span></a><a class="side-link" href="/admin/#products">◇ <span>Products</span></a><a class="side-link" href="/admin/#customers">○ <span>Customers</span></a><a class="side-link active" href="/admin/emails/">✉ <span>Messages</span></a></nav><div class="sidebar-foot"><a href="/" target="_blank">View storefront ↗</a><button data-logout>Log out</button></div></aside><main class="dashboard-main"><header class="dashboard-top"><button class="menu-button" data-menu>☰</button><div><p class="eyebrow">SERUM 72 ADMIN</p><h1>Messages</h1></div><div class="admin-profile"><span>S72</span><div><strong>Store admin</strong><small>Operations</small></div></div></header><section class="view active"><div class="section-heading"><div><h2>Inbound &amp; outbound emails</h2><p>Contact submissions and transactional delivery attempts.</p></div><p data-count>Loading records…</p></div><section class="dash-card"><div class="filter-bar email-filters"><input type="search" placeholder="Search sender, recipient, or subject" data-search><select data-direction><option value="">All messages</option><option value="inbound">Inbound</option><option value="outbound">Outbound</option></select><button class="btn" data-refresh>REFRESH</button></div><div data-loading class="detail-loading">Loading messages…</div><div data-empty class="empty" hidden>No messages match this view.</div><div class="responsive-table" data-table hidden><table><thead><tr><th>Direction</th><th>Date</th><th>From / To</th><th>Subject &amp; preview</th><th>Status</th></tr></thead><tbody data-rows></tbody></table></div></section></section></main></div></AdminLayout>
<script>
const api=location.port==='4321'?'http://localhost/serum72/api':`${location.pathname.split('/admin/')[0]}/api`;let messages:any[]=[];const $=(s:string)=>document.querySelector(s) as HTMLElement,escape=(v:any)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'} as any)[c]);function render(){const q=($('[data-search]') as HTMLInputElement).value.toLowerCase().trim(),direction=($('[data-direction]') as HTMLSelectElement).value,rows=messages.filter(m=>(!direction||m.direction===direction)&&(!q||[m.from,m.to,m.subject,m.preview].join(' ').toLowerCase().includes(q))),base=location.pathname.split('/admin/')[0];$('[data-loading]').hidden=true;$('[data-empty]').hidden=rows.length>0;$('[data-table]').hidden=!rows.length;$('[data-count]').textContent=`${rows.length} message${rows.length===1?'':'s'}`;$('[data-rows]').innerHTML=rows.map(m=>`<tr class="clickable-row" data-url="${base}/admin/email/?id=${encodeURIComponent(m.id)}"><td><span class="direction direction--${escape(m.direction)}">${escape(m.direction)}</span></td><td class="muted">${escape(new Date(m.date).toLocaleString())}</td><td><strong>${escape(m.from||'—')}</strong><small>To: ${escape(m.to||'—')}</small></td><td><a class="record-link" href="${base}/admin/email/?id=${encodeURIComponent(m.id)}">${escape(m.subject||'(No subject)')}</a><div class="muted preview">${escape(m.preview||'')}</div></td><td><span class="status">${escape(m.status||'saved')}</span></td></tr>`).join('');document.querySelectorAll<HTMLElement>('.clickable-row').forEach(row=>row.addEventListener('click',event=>{if(!(event.target as HTMLElement).closest('a'))location.href=row.dataset.url!}))}async function load(){try{const r=await fetch(`${api}/admin-emails.php`,{credentials:'include'}),d=await r.json();if(r.status===401){location.replace('/admin/login/');return}if(!r.ok)throw new Error(d.error);messages=d.messages||[];render()}catch(x){$('[data-loading]').textContent=x instanceof Error?x.message:'Unable to load records.'}}$('[data-search]').addEventListener('input',render);$('[data-direction]').addEventListener('change',render);$('[data-refresh]').addEventListener('click',load);$('[data-menu]').addEventListener('click',()=>document.body.classList.toggle('menu-open'));$('[data-logout]').addEventListener('click',async()=>{try{await fetch(`${api}/admin-logout.php`,{method:'POST',credentials:'include'})}finally{location.href='/admin/login/'}});load();
</script>
