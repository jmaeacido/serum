---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, type Product } from '../../data/products';
export function getStaticPaths(){ return products.map(product => ({ params:{ slug:product.slug }, props:{ product } })); }
interface Props { product: Product }
const { product } = Astro.props;
const index = products.findIndex(item => item.slug === product.slug);
const previous = products[(index - 1 + products.length) % products.length];
const next = products[(index + 1) % products.length];
const recommendations = products.filter(item => item.slug !== product.slug);
const subjectImages: Record<string, string> = { 'night-cream':'/assets/subjects/night.png', 'day-cream':'/assets/subjects/day.png', serum:'/assets/subjects/serum%20retinol.png', 'mineral-sunscreen':'/assets/subjects/sunscreen.png', 'dual-action-cleanser':'/assets/subjects/cleanser.png' };
const alternateImages: Record<string, string> = { 'night-cream':'/assets/subjects/night2.png', 'day-cream':'/assets/daycream.png', serum:'/assets/retinol.png', 'mineral-sunscreen':'/assets/sunscreen.png', 'dual-action-cleanser':'/assets/cleanser.png' };
const galleryImages = [product.image, product.storyImage, subjectImages[product.slug], alternateImages[product.slug]];
const url = `https://www.serum72.com/shop/${product.slug}/`;
const schema = { '@context':'https://schema.org','@type':'Product',name:product.name,image:[`https://www.serum72.com${product.image}`],description:product.short,brand:{'@type':'Brand',name:'Native Ceuticals'},offers:{'@type':'Offer',url,priceCurrency:'USD',price:product.price,availability:'https://schema.org/InStock',itemCondition:'https://schema.org/NewCondition'} };
---
<BaseLayout title={`${product.name} | Serum 72`} description={product.short} image={product.image} schema={schema}>
  <article class="live-product">
    <nav class="product-pager" aria-label="Product"><a href={`/shop/${previous.slug}/`}>‹ Previous</a><span>|</span><a href={`/shop/${next.slug}/`}>Next ›</a></nav>
    <div class="live-product-main">
      <section class="product-gallery" aria-label={`${product.name} gallery`}>
        <div class="gallery-stage" data-gallery-stage role="button" tabindex="0" aria-label={`View current ${product.name} image full screen`}><div class="gallery-track" data-gallery-track>{galleryImages.map((image, imageIndex) => <div class="gallery-slide"><img src={image} alt={imageIndex === 0 ? product.name : `${product.name} view ${imageIndex + 1}`} /></div>)}</div></div>
        <div class="gallery-thumbnails">{galleryImages.map((image, imageIndex) => <button type="button" class:list={[imageIndex === 0 && 'active']} data-gallery-thumbnail data-index={imageIndex} data-image={image} aria-label={`View ${product.name} image ${imageIndex + 1}`}><img src={image} alt="" /></button>)}</div>
      </section>
      <section class="purchase-panel">
        <div class="purchase-scroll">
          <h1>{product.name}</h1><p class="live-price">${product.price.toFixed(2)}</p><p class="product-description">{product.short}</p>
          <fieldset class="price-options"><legend>Price Options</legend><label><input type="radio" name="purchase-option" checked /><span><b>One-time purchase</b><small>${product.price.toFixed(2)}</small></span></label><label><input type="radio" name="purchase-option" /><span><b>Subscribe Monthly</b><em>Save 10%</em><small>${product.subscriptionPrice.toFixed(2)} every month until canceled</small></span></label></fieldset>
          <div class="product-accordions"><details open><summary>Ingredients</summary><p>{product.ingredients}</p></details><details><summary>How it works</summary><p><strong>Suggested Use:</strong><br />{product.suggestedUse}</p><p>This product is not evaluated by the FDA and is not intended to diagnose, treat, or cure any disease.</p></details><details><summary>What is a COA &amp; Why It Matters?</summary><p>A Certificate of Analysis is a lab-tested quality report that verifies purity, potency, and safety.</p></details><details><summary>What does the {product.name} do?</summary><p>{product.paragraphs[1]}</p></details><details><summary>When should I use the {product.name}?</summary><p>{product.suggestedUse}</p></details></div>
        </div>
        <div class="purchase-actions"><label class="quantity-label" for="quantity">Quantity</label><div class="quantity-picker"><button type="button" data-qty-minus aria-label="Remove one">−</button><input id="quantity" value="1" inputmode="numeric" aria-label="Quantity" /><button type="button" data-qty-plus aria-label="Add one">+</button></div><div class="purchase-buttons"><button class="product-add" type="button" data-add-to-cart data-slug={product.slug} data-name={product.name} data-price={product.price} data-image={product.image}>Add to Cart</button><a class="product-buy" href="/checkout/">BUY NOW</a></div></div>
      </section>
    </div>
  </article>
  <dialog class="gallery-lightbox" data-gallery-lightbox aria-label={`${product.name} full-screen gallery`}><button class="lightbox-close" type="button" data-lightbox-close aria-label="Close full-screen gallery"></button><button class="lightbox-arrow previous" type="button" data-lightbox-previous aria-label="Previous image">‹</button><img src={galleryImages[0]} alt={product.name} data-lightbox-image /><button class="lightbox-arrow next" type="button" data-lightbox-next aria-label="Next image">›</button></dialog>
  <section class="routine-products"><p class="routine-eyebrow">Complete your routine</p><h2>You may also like</h2><div class="routine-grid">{recommendations.map(item => <article><figure><a href={`/shop/${item.slug}/`}><img class="routine-primary" src={item.image} alt={item.name} /><img class="routine-hover" src={item.storyImage} alt="" /></a><button class="quick-view-trigger" type="button" data-quick-view data-slug={item.slug} data-name={item.name} data-price={item.price} data-subscription-price={item.subscriptionPrice} data-image={item.image} data-image-2={item.storyImage} data-image-3={subjectImages[item.slug]} data-image-4={alternateImages[item.slug]}>Quick View</button></figure><a href={`/shop/${item.slug}/`}><h3>{item.name}</h3><p>${item.price.toFixed(2)}</p></a><button type="button" data-add-to-cart data-slug={item.slug} data-name={item.name} data-price={item.price} data-image={item.image}>Add to Cart</button></article>)}</div></section>
  <dialog class="quick-view-modal" data-quick-view-modal aria-label="Quick product view"><button class="quick-view-close" type="button" data-quick-view-close aria-label="Close quick view"></button><div class="quick-view-media"><img src="" alt="" data-quick-view-image /><div class="quick-view-dots" aria-label="Product images">{[0,1,2,3].map(dot => <button type="button" class:list={[dot === 0 && 'active']} data-quick-dot data-index={dot} aria-label={`View image ${dot + 1}`}></button>)}</div></div><div class="quick-view-purchase"><h2 data-quick-view-name></h2><p class="quick-view-price" data-quick-view-price></p><div class="quick-view-scroll"><label>Quantity *</label><div class="quick-view-quantity"><button type="button" data-quick-minus>−</button><span data-quick-quantity>1</span><button type="button" data-quick-plus>+</button></div><fieldset><legend>Price Options *</legend><label><input type="radio" name="quick-option" checked /><span>One-time purchase<small data-quick-one-time></small></span></label><label><input type="radio" name="quick-option" /><span>Subscribe Monthly<em>Save 10%</em><small data-quick-subscription></small></span></label></fieldset></div><div class="quick-view-actions"><button class="quick-cart" type="button" data-add-to-cart>Add to Cart</button><button class="quick-subscribe" type="button">Subscribe Now</button><a data-quick-details>View More Details</a></div></div></dialog>
  <section class="product-mission" data-product-mission><div class="product-mission-inner"><h2>Our Mission</h2><p>“We believe skincare should feel simple and effective — every single day.”</p></div></section>
</BaseLayout>
<script>
  const mission = document.querySelector<HTMLElement>('[data-product-mission]');
  if (mission) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      mission.classList.add('is-visible');
    } else {
      const missionObserver = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) {
          mission.classList.add('is-visible');
          missionObserver.disconnect();
        }
      }, { threshold: .22 });
      missionObserver.observe(mission);
    }
  }
  const quantity = document.querySelector<HTMLInputElement>('#quantity');
  document.querySelector('[data-qty-minus]')?.addEventListener('click', () => { if (quantity) quantity.value = String(Math.max(1, Number(quantity.value) - 1)); });
  document.querySelector('[data-qty-plus]')?.addEventListener('click', () => { if (quantity) quantity.value = String(Math.max(1, Number(quantity.value) + 1)); });
  const galleryStage = document.querySelector<HTMLElement>('[data-gallery-stage]');
  const galleryTrack = document.querySelector<HTMLElement>('[data-gallery-track]');
  const galleryThumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumbnail]'));
  const lightbox = document.querySelector<HTMLDialogElement>('[data-gallery-lightbox]');
  const lightboxImage = document.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const lightboxPrevious = document.querySelector<HTMLButtonElement>('[data-lightbox-previous]');
  const lightboxNext = document.querySelector<HTMLButtonElement>('[data-lightbox-next]');
  let galleryIndex = 0;
  let dragStart = 0;
  let dragOffset = 0;
  let dragging = false;

  const moveGallery = (nextIndex: number, animate = true) => {
    if (!galleryTrack) return;
    galleryIndex = Math.max(0, Math.min(galleryThumbs.length - 1, nextIndex));
    galleryTrack.classList.toggle('dragging', !animate);
    galleryTrack.style.transform = `translate3d(${-galleryIndex * 100}%,0,0)`;
    galleryThumbs.forEach((thumb, index) => thumb.classList.toggle('active', index === galleryIndex));
    if (lightboxImage && galleryThumbs[galleryIndex]?.dataset.image) lightboxImage.src = galleryThumbs[galleryIndex].dataset.image!;
    if (lightboxPrevious) lightboxPrevious.hidden = galleryIndex === 0;
    if (lightboxNext) lightboxNext.hidden = galleryIndex === galleryThumbs.length - 1;
  };

  galleryThumbs.forEach((thumbnail) => thumbnail.addEventListener('click', () => moveGallery(Number(thumbnail.dataset.index))));

  galleryStage?.addEventListener('pointerdown', (event) => {
    if (!galleryTrack) return;
    dragging = true;
    dragStart = event.clientX;
    dragOffset = 0;
    galleryTrack.classList.add('dragging');
    galleryStage.setPointerCapture(event.pointerId);
  });
  galleryStage?.addEventListener('pointermove', (event) => {
    if (!dragging || !galleryTrack || !galleryStage) return;
    dragOffset = event.clientX - dragStart;
    const percent = dragOffset / galleryStage.clientWidth * 100;
    galleryTrack.style.transform = `translate3d(${(-galleryIndex * 100) + percent}%,0,0)`;
  });
  const finishGalleryDrag = () => {
    if (!dragging || !galleryStage) return;
    dragging = false;
    const threshold = Math.min(90, galleryStage.clientWidth * .16);
    const direction = dragOffset < -threshold ? 1 : dragOffset > threshold ? -1 : 0;
    moveGallery(galleryIndex + direction);
  };
  galleryStage?.addEventListener('pointerup', finishGalleryDrag);
  galleryStage?.addEventListener('pointercancel', finishGalleryDrag);
  const openLightbox = () => {
    if (!lightbox || Math.abs(dragOffset) > 6) return;
    if (lightboxImage && galleryThumbs[galleryIndex]?.dataset.image) lightboxImage.src = galleryThumbs[galleryIndex].dataset.image!;
    lightbox.showModal();
  };
  galleryStage?.addEventListener('click', openLightbox);
  galleryStage?.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openLightbox(); } });
  document.querySelector('[data-lightbox-close]')?.addEventListener('click', () => lightbox?.close());
  lightboxPrevious?.addEventListener('click', () => moveGallery(galleryIndex - 1));
  lightboxNext?.addEventListener('click', () => moveGallery(galleryIndex + 1));
  moveGallery(0, false);

  const quickModal = document.querySelector<HTMLDialogElement>('[data-quick-view-modal]');
  const quickCart = quickModal?.querySelector<HTMLButtonElement>('[data-add-to-cart]');
  const quickImage = quickModal?.querySelector<HTMLImageElement>('[data-quick-view-image]');
  const quickDots = Array.from(quickModal?.querySelectorAll<HTMLButtonElement>('[data-quick-dot]') || []);
  let quickImages: string[] = [];
  let quickQuantity = 1;
  const renderQuickQuantity = () => { const output = quickModal?.querySelector('[data-quick-quantity]'); if (output) output.textContent = String(quickQuantity); };
  document.querySelectorAll<HTMLButtonElement>('[data-quick-view]').forEach(button => button.addEventListener('click', () => {
    if (!quickModal) return;
    quickQuantity = 1; renderQuickQuantity();
    const setText = (selector: string, value = '') => { const node = quickModal.querySelector(selector); if (node) node.textContent = value; };
    quickImages = [button.dataset.image, button.getAttribute('data-image-2'), button.getAttribute('data-image-3'), button.getAttribute('data-image-4')].filter((image): image is string => Boolean(image));
    if (quickImage) { quickImage.src = quickImages[0] || ''; quickImage.alt = button.dataset.name || ''; }
    quickDots.forEach((dot, index) => { dot.hidden = !quickImages[index]; dot.classList.toggle('active', index === 0); });
    setText('[data-quick-view-name]', button.dataset.name);
    setText('[data-quick-view-price]', `$${Number(button.dataset.price).toFixed(2)}`);
    setText('[data-quick-one-time]', `$${Number(button.dataset.price).toFixed(2)}`);
    setText('[data-quick-subscription]', `$${Number(button.dataset.subscriptionPrice).toFixed(2)} every month until canceled`);
    const details = quickModal.querySelector<HTMLAnchorElement>('[data-quick-details]');
    if (details) details.href = `/shop/${button.dataset.slug}/`;
    if (quickCart) Object.assign(quickCart.dataset, { slug:button.dataset.slug || '', name:button.dataset.name || '', price:button.dataset.price || '', image:button.dataset.image || '' });
    quickModal.showModal();
  }));
  quickModal?.querySelector('[data-quick-view-close]')?.addEventListener('click', () => quickModal.close());
  quickModal?.querySelector('[data-quick-minus]')?.addEventListener('click', () => { quickQuantity = Math.max(1, quickQuantity - 1); renderQuickQuantity(); });
  quickModal?.querySelector('[data-quick-plus]')?.addEventListener('click', () => { quickQuantity += 1; renderQuickQuantity(); });
  quickDots.forEach(dot => dot.addEventListener('click', () => { const index = Number(dot.dataset.index); if (!quickImage || !quickImages[index]) return; quickImage.src = quickImages[index]; quickDots.forEach((item, itemIndex) => item.classList.toggle('active', itemIndex === index)); }));
</script>
