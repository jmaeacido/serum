---
import BaseLayout from '../layouts/BaseLayout.astro';
const faqs = [
  ['What is Native Ceuticals Skincare?', 'Native Ceuticals Skincare is a four-product line designed to cleanse, fortify, renew, and restore the skin. The line includes Premium Cleanser, Fortify Day Cream, Radiance Serum, and Night Cream.'],
  ['What is the best routine using these products?', 'Start with Premium Cleanser. In the morning, follow with Fortify Day Cream. At night, cleanse again, apply Radiance Serum, and finish with Night Cream.'],
  ['Can I use all four products together?', 'Yes. The four products work together as a complete morning and evening skincare ritual.'],
  ['Which product should I use first?', 'Always start with Premium Cleanser. Clean skin allows the next products to apply evenly and work effectively.'],
  ['Which product should I use during the day?', 'Use Fortify Day Cream in the morning for hydration, brightening, and skin-barrier support.'],
  ['Which product should I use at night?', 'Use Radiance Serum at night after cleansing, then apply Night Cream once the serum has absorbed.'],
  ['Are these products made with clean ingredients?', 'The formulas use skin-supporting ingredients including aloe vera, ectoin, peptides, jojoba oil, kokum butter, mango butter, hyaluronic acid, Vitamin C, and Vitamin E.'],
  ['Are the products CBD-free?', 'Yes. All four products in the current skincare collection are marked CBD-free.'],
  ['Are these products lab-tested?', 'Yes. Each product is backed by a Certificate of Analysis, also known as a COA. This verifies product quality, potency, and transparency, so customers know exactly what they are using.'],
  ['Who should not use these products?', 'These products are not for use by anyone under 18, or by women who may be pregnant or nursing. Anyone with sensitive skin, allergies, existing skin conditions, or medical concerns should consult a physician before use.']
];
---
<BaseLayout title="Frequently Asked Questions | Serum 72" description="Answers to common questions about Serum 72 products and skincare routines.">
  <header class="page-hero"><p class="eyebrow">GOT QUESTIONS?</p><h1>Everything You Need to Know</h1><p>From ingredients to delivery — find quick answers to our most common questions below.</p></header>
  <article class="content wide-content"><p class="eyebrow">FREQUENTLY ASKED QUESTIONS</p><h2>Common questions.</h2><div class="faq-list">{faqs.map(([q,a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}</div></article>
  <section class="page-cta"><h2>Ready to Reveal Your Best Skin?</h2><p>Start your glow journey today.</p><a class="btn" href="/shop/">READY TO REVEAL</a></section>
</BaseLayout>
