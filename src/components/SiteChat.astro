<div class="site-chat-root">
  <div class="site-chat-panel" id="site-chat-panel" hidden>
    <header class="site-chat-head">
      <div>
        <strong>Alloy Beauty</strong>
        <p><span class="site-chat-dot" aria-hidden="true"></span> We’ll reply as soon as we can</p>
      </div>
      <button type="button" data-chat-close aria-label="Close chat">×</button>
    </header>
    <div class="site-chat-log" data-chat-log>
      <p class="site-chat-bot">Hey there, please leave your details so we can contact you even if you are no longer on the site.</p>
    </div>
    <form class="site-chat-form" data-chat-form>
      <input class="contact-honeypot" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input name="name" autocomplete="name" required placeholder="Name" aria-label="Name" />
      <input name="email" type="email" autocomplete="email" required placeholder="Email" aria-label="Email" />
      <textarea name="message" placeholder="How can we help?" aria-label="How can we help?"></textarea>
      <button type="submit">Submit</button>
    </form>
    <label class="site-chat-compose">
      <input name="message" placeholder="Type your message..." aria-label="Type your message" />
      <span class="site-chat-tools" aria-hidden="true">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8.5 14.2c1.1 1.2 2.6 1.8 3.5 1.8s2.4-.6 3.5-1.8" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="9" cy="10" r="1" fill="currentColor"/><circle cx="15" cy="10" r="1" fill="currentColor"/></svg>
        <svg viewBox="0 0 24 24"><path d="M8 14.5 14.2 8.3a2.2 2.2 0 0 1 3.1 3.1L10 18.7a3.6 3.6 0 0 1-5.1-5.1l8-8" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </span>
    </label>
  </div>
  <button class="site-chat" type="button" data-chat-toggle aria-expanded="false" aria-controls="site-chat-panel" aria-label="Open live chat">
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <path fill="none" stroke="#fff" stroke-width="2.2" stroke-linejoin="round" d="M10 12h28a3 3 0 0 1 3 3v16a3 3 0 0 1-3 3H22l-8 7v-7h-4a3 3 0 0 1-3-3V15a3 3 0 0 1 3-3Z"/>
      <circle cx="18" cy="23" r="1.7" fill="#fff"/>
      <circle cx="24" cy="23" r="1.7" fill="#fff"/>
      <circle cx="30" cy="23" r="1.7" fill="#fff"/>
    </svg>
  </button>
</div>
<script>
  const root = document.querySelector('.site-chat-root');
  const toggle = root?.querySelector('[data-chat-toggle]');
  const close = root?.querySelector('[data-chat-close]');
  const panel = document.getElementById('site-chat-panel');
  const form = root?.querySelector<HTMLFormElement>('[data-chat-form]');
  const log = root?.querySelector('[data-chat-log]');
  const setOpen = (open: boolean) => {
    panel?.toggleAttribute('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => setOpen(panel?.hasAttribute('hidden') ?? true));
  close?.addEventListener('click', () => setOpen(false));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    try {
      const values = Object.fromEntries(new FormData(form).entries());
      const apiUrl = window.location.port === '4321' ? 'http://localhost/serum72/api/contact.php' : '/api/contact.php';
      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ source: 'chat', ...values }),
      });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.message || 'Unable to send your details.');
      const name = String(values.name || 'there');
      const note = document.createElement('p');
      note.className = 'site-chat-user';
      note.textContent = `Thanks ${name.split(' ')[0]}. We’ll be in touch.`;
      log?.append(note);
      form.reset();
    } catch (error) {
      const note = document.createElement('p');
      note.className = 'site-chat-bot';
      note.textContent = error instanceof Error ? error.message : 'Unable to send your details. Please try again.';
      log?.append(note);
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
