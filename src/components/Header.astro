---
import { products } from '../data/products';
const path = Astro.url.pathname;
const current = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<header class="site-header">
  <a class="logo" href="/" aria-label="Native Ceuticals home"><img src="/assets/site/logo-footer-hi.png" alt="Native Ceuticals" /></a>
  <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false">Menu</button>
  <nav class="site-nav" aria-label="Primary">
    <a class:list={{ current: current('/') }} href="/">Home</a>
    <div class="shop-dropdown" data-shop-dropdown>
      <button class:list={{ current: current('/shop') }} type="button" data-shop-toggle aria-expanded="false" aria-haspopup="true"><span class="shop-label">Shop</span> <span class="shop-chevron" aria-hidden="true"></span></button>
      <div class="shop-menu" data-shop-menu>
        {products.map(product => <a href={`/shop/${product.slug}/`}>{product.name}</a>)}
      </div>
    </div>
    <a class:list={{ current: current('/about') }} href="/about/">About Us</a>
    <a class:list={{ current: current('/contact') }} href="/contact/">Contact Us</a>
  </nav>
  <div class="header-actions">
    <a class:list={{ 'login-link': true, current: current('/login') }} href="/login/">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 12a4.5 4.5 0 1 0-4.5-4.5A4.5 4.5 0 0 0 12 12Zm0 2.25c-3.6 0-8.25 1.8-8.25 5.25V21h16.5v-1.5c0-3.45-4.65-5.25-8.25-5.25Z" /></svg>
      <span data-auth-label>Log In</span>
    </a>
    <button class="cart-link" type="button" data-cart-open aria-label="Open shopping cart">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.75 8.25V7.5a5.25 5.25 0 0 1 10.5 0v.75h2.1l1.4 12H3.25l1.4-12Zm1.5 0h7.5V7.5a3.75 3.75 0 0 0-7.5 0Z" /></svg>
      <span class="cart-count" data-cart-count hidden>0</span>
    </button>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = document.body.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  const accountApi = window.location.port === '4321' ? 'http://localhost/serum72/api/auth.php' : '/serum72/api/auth.php';
  fetch(accountApi, { credentials:'include' }).then(response => response.json()).then(data => {
    const label = document.querySelector<HTMLElement>('[data-auth-label]');
    if (label && data.user?.name) label.textContent = data.user.name.split(' ')[0];
  }).catch(() => {});
  const shopDropdown = document.querySelector<HTMLElement>('[data-shop-dropdown]');
  const shopToggle = shopDropdown?.querySelector<HTMLButtonElement>('[data-shop-toggle]');
  const setShopOpen = (open:boolean) => { shopDropdown?.classList.toggle('open',open); shopToggle?.setAttribute('aria-expanded',String(open)); };
  shopToggle?.addEventListener('click', () => setShopOpen(!shopDropdown?.classList.contains('open')));
  const hoverShop = window.matchMedia('(hover: hover) and (pointer: fine)');
  shopDropdown?.addEventListener('mouseenter', () => { if (hoverShop.matches) setShopOpen(true); });
  shopDropdown?.addEventListener('mouseleave', () => { if (hoverShop.matches) setShopOpen(false); });
  document.addEventListener('click', event => { if(shopDropdown && !shopDropdown.contains(event.target as Node)) setShopOpen(false); });
  document.addEventListener('keydown', event => { if(event.key==='Escape'){setShopOpen(false);shopToggle?.focus();} });
</script>
